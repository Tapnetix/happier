# ---------------------------------------------------------------------------
# Happier self-host configuration (light flavor: SQLite + local files, no
# Postgres/Redis/S3).
#
# Copy this file to a real env file at the repo root and fill it in:
#
#   cp deploy/selfhost/env.example .env.selfhost
#   chmod 600 .env.selfhost
#   # edit .env.selfhost, then:
#   docker compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d
#
# The one file feeds BOTH compose interpolation (${HAPPIER_DOMAIN},
# ${HAPPIER_IMAGE}) and the server container's runtime environment.
# Keep .env.selfhost out of git — it holds your master secret.
# ---------------------------------------------------------------------------

# Public hostname clients connect to. Must have a DNS record pointing at this
# box and be reachable on 80/443 for Caddy to obtain a TLS certificate.
HAPPIER_DOMAIN=hdev.tapnetix.com

# Optional: email used for Let's Encrypt expiry notices.
ACME_EMAIL=

# Server image. Default is the upstream-published light-flavor image (fastest,
# no build). Pin to a digest for reproducibility, e.g.
#   HAPPIER_IMAGE=happierdev/relay-server@sha256:<digest>
# To build from THIS fork instead, see docker-compose.selfhost.yml (build stanza).
HAPPIER_IMAGE=happierdev/relay-server:preview

# --- Server runtime (read by the Happier server) -------------------------------

# Master secret: seeds auth-token signing and server-side token encryption.
# Generate a strong value ONCE and keep it backed up off-box:
#   openssl rand -base64 48
# If left blank, the server auto-generates one and persists it to
# /data/handy-master-secret.txt (durable as long as the volume survives), but
# setting it explicitly here is recommended so it is backed up with your config.
HANDY_MASTER_SECRET=

# Canonical URLs embedded in QR codes / device-link deep links / OAuth redirects.
# For the light flavor the API and web UI share one origin.
HAPPIER_PUBLIC_SERVER_URL=https://hdev.tapnetix.com
HAPPIER_WEBAPP_URL=https://hdev.tapnetix.com

# The server sits behind Caddy, so trust X-Forwarded-* for correct client IPs
# (used by rate limiting).
HAPPIER_SERVER_TRUST_PROXY=true

# Account signup policy. Leave true to register your own devices on first run,
# then set to false and `docker compose ... up -d` again so no stranger can
# create accounts on your server.
AUTH_ANONYMOUS_SIGNUP_ENABLED=true

# Prometheus metrics endpoint has no auth; keep it off unless you scrape it on
# a private network.
METRICS_ENABLED=false
